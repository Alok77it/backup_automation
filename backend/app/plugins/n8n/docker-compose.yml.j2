# n8n — DevOps Control Plane managed deployment
# Generated by Plugin Manager — do not edit manually
# Server: {{ server_hostname }}

services:
  n8n:
    image: n8nio/n8n:{{ n8n_version | default('latest') }}
    container_name: n8n
    restart: unless-stopped
    ports:
      - "{{ n8n_port | default(5678) }}:5678"
    environment:
      - N8N_HOST={{ n8n_host }}
      - N8N_PORT=5678
      - N8N_PROTOCOL={{ n8n_protocol | default('https' if ssl_enabled else 'http') }}
      - WEBHOOK_URL={{ webhook_url | default((n8n_protocol | default('https' if ssl_enabled else 'http')) ~ '://' ~ n8n_host ~ ('' if ssl_enabled else ':' ~ (n8n_port | default(5678))) ~ '/') }}
      - N8N_SECURE_COOKIE={{ 'true' if ssl_enabled else 'false' }}
      - N8N_PROXY_HOPS=1
      - N8N_BASIC_AUTH_ACTIVE={{ 'true' if n8n_basic_auth_active else 'false' }}
      - N8N_BASIC_AUTH_USER={{ n8n_basic_auth_user | default('admin') }}
      - N8N_BASIC_AUTH_PASSWORD={{ n8n_basic_auth_password }}
      - N8N_ENCRYPTION_KEY={{ n8n_encryption_key }}
      - GENERIC_TIMEZONE={{ timezone | default('UTC') }}
      - TZ={{ timezone | default('UTC') }}
      # Fix common SSL issues behind reverse proxy
      - NODE_TLS_REJECT_UNAUTHORIZED=0
      - N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=true
    volumes:
      - n8n_data:/home/node/.n8n
      - /var/run/docker.sock:/var/run/docker.sock:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5678/healthz"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

volumes:
  n8n_data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{ install_path | default('/opt/n8n') }}/data
