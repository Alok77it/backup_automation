# Docker Hub image settings
IMAGE_NAMESPACE=yourdockerhub
IMAGE_TAG=latest

# Public ports
HTTP_PORT=80
PROMETHEUS_PORT=9090

# Required application secrets
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
ENCRYPTION_KEY=change-this-to-another-long-random-secret-key

# Database
POSTGRES_USER=backupintel
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=backup_intelligence

# Storage
BACKUP_STORAGE_PATH=/data/backups

# Public URLs
FRONTEND_URL=http://YOUR_SERVER_IP
API_URL=http://YOUR_SERVER_IP/api
CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost,http://localhost:3000

# Optional AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
