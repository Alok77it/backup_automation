# Required
DATABASE_URL=postgresql://backupintel:backupintel_secret@postgres:5432/backup_intelligence
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
ENCRYPTION_KEY=change-this-to-another-long-random-secret-key

# Optional AI (auto-detects provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Internal (defaults work with docker-compose)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
BACKUP_STORAGE_PATH=/data/backups
FRONTEND_URL=http://localhost
API_URL=http://localhost/api
CORS_ORIGINS=http://localhost,http://localhost:3000
POSTGRES_USER=backupintel
POSTGRES_PASSWORD=backupintel_secret
POSTGRES_DB=backup_intelligence
