[Unit]
Description=DevOps Control Plane Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/devops-agent
EnvironmentFile=/opt/devops-agent/.env
ExecStart=/usr/bin/python3 /opt/devops-agent/agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devops-agent

# Security hardening
NoNewPrivileges=no
ProtectSystem=false
ReadWritePaths=/opt /var/log /etc/nginx /var/www

[Install]
WantedBy=multi-user.target
